[Unit]
Description=Periodic Uma Musume Live Wiki data refresh

[Timer]
# First run 15 minutes after boot, then every 6 hours. Randomized to avoid
# hitting upstream sites at the same minute as other jobs.
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=30min
Persistent=true
Unit=umamusume-refresh.service

[Install]
WantedBy=timers.target
