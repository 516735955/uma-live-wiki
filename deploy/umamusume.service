[Unit]
Description=Uma Musume Live Wiki
After=network.target

[Service]
Type=simple
User=alaemiryoung
Group=alaemiryoung
WorkingDirectory=/var/www/umamusume/current
# Legacy migration unit. New deployments use umamusume@8080/8081.service.
# The active instance checks knowledge sources hourly and news every 30 minutes.
# umamusume-update.timer publishes the latest main daily at 04:00 Asia/Shanghai.
ExecStart=/usr/bin/node /var/www/umamusume/current/uma_tools/server.js 8080 /var/www/umamusume/current
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
